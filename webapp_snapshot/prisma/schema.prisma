generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WorkPeriod {
  id                 String            @id @default(uuid())
  period_key         String            @unique
  year               Int
  month              Int
  status             String            @default("DRAFT")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  pymeMultiplier     Float             @default(5)
  tramo1Limit        Float             @default(50)
  tramo2Limit        Float             @default(80)
  tramo3Limit        Float             @default(100)
  visitasM1Contactos Float             @default(25)
  visitasM1Visitas   Float             @default(10)
  visitasM2Contactos Float             @default(55)
  visitasM2Visitas   Float             @default(30)
  visitasM3Contactos Float             @default(90)
  visitasM3Visitas   Float             @default(50)
  extraAssignments   ExtraAssignment[]
  extraRules         ExtraRule[]
  importePlus        ImportePlus[]
  importePyme        ImportePyme[]
  objectives         Objective[]
  catalogs           ProductCatalog[]
  sales              Sale[]

  @@unique([year, month])
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  password        String
  role            String
  permissions     String
  codigoComercial String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductCatalog {
  id               String      @id @default(uuid())
  categoria        String
  producto         String
  mensual          String
  anual            String
  validFrom        String?
  validTo          String?
  periodId         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  fabricante       String?
  gama             String?
  subcategoria     String?
  comision         String?
  comisionConCoste String?
  period           WorkPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String      @id @default(uuid())
  sheet         String
  vendedor      String
  fecha         String
  codigo        String?
  producto      String?
  nif           String?
  nombreCliente String?
  potencial     String?
  telf          String?
  pendiente     String?
  anulado       String?
  anotaciones   String?
  grupo         String?
  cuota         Float?
  detalle       String?
  periodId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  boletin       String?
  telefonoFijo  String?
  telefonoMovil String?
  imei          String?
  rentConCoste  String?
  seguro        String?
  seguroImporte Float?
  isLibre       Boolean?
  isSwap        Boolean?
  period        WorkPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model Objective {
  id        String      @id @default(uuid())
  profile   String
  month     String
  objKey    String
  value     Float
  grupo     String?
  periodId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  period    WorkPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CondicionPlus {
  id                String   @id @default(uuid())
  concepto          String
  importeObj1       Float    @default(0)
  importeObj2       Float    @default(0)
  extrasTodaEmpresa Float    @default(0)
  objTodaEmpresa    Float    @default(0)
  objetivo1         Float    @default(0)
  objetivo2         Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ImportePyme {
  id                          String      @id @default(uuid())
  concepto                    String
  objetivoUds                 Float?
  totalObjetivos              Float?
  objetivoPlus100             Float?
  comisionNacionalMenos50     Float?
  comisionNacionalEntre50Y80  Float?
  comisionNacionalEntre80Y100 Float?
  comisionNacionalMas100      Float?
  operacionesAsignadas        String?
  grupo                       String?
  isPercentage                Boolean     @default(false)
  periodId                    String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  period                      WorkPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model ImportePlus {
  id                          String      @id @default(uuid())
  concepto                    String
  objetivoUds                 Float?
  totalObjetivos              Float?
  objetivoPlus100             Float?
  comisionNacionalMenos50     Float?
  comisionNacionalEntre50Y80  Float?
  comisionNacionalEntre80Y100 Float?
  comisionNacionalMas100      Float?
  operacionesAsignadas        String?
  grupo                       String?
  isPercentage                Boolean     @default(false)
  periodId                    String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  period                      WorkPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model AgendaEntry {
  id              String   @id @default(uuid())
  codigoComercial String
  fecha           DateTime
  ventas          Int      @default(0)
  visitas         Int      @default(0)
  teams           Int      @default(0)
  demos           Int      @default(0)
  estado          String   @default("ACTIVO")
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([codigoComercial, fecha])
  @@index([fecha])
}

model AgendaCristinaEntry {
  id              String   @id @default(cuid())
  codigoComercial String
  fecha           DateTime
  campanas        Int      @default(0)
  clientesPropios Int      @default(0)
  dispositivos    Int      @default(0)
  baf             Int      @default(0)
  repos           Int      @default(0)
  bdSalva         Int      @default(0)
  competencia     Int      @default(0)
  estado          String   @default("ACTIVO")
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([codigoComercial, fecha])
  @@index([fecha])
}

model Magazine {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  month       Int
  year        Int
  description String?
  pdfUrl      String
  coverUrl    String?
  isPublished Boolean        @default(false)
  isFeatured  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  views       MagazineView[]
}

model MagazineView {
  id         String   @id @default(cuid())
  magazineId String
  userId     String
  openedAt   DateTime @default(now())
  pageViews  String?
  magazine   Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
}

model TrackingPeriod {
  id        String          @id @default(cuid())
  month     Int
  year      Int
  status    String          @default("OPEN")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now())
  groups    TrackingGroup[]

  @@unique([month, year])
}

model TrackingGroup {
  id        String         @id @default(cuid())
  periodId  String
  name      String
  order     Int
  pymeVal   Float?
  basicoVal Float?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now())
  period    TrackingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  rows      TrackingRow[]
}

model TrackingRow {
  id             String        @id @default(cuid())
  groupId        String
  comercialName  String
  objectiveMonth Float         @default(0)
  week1          Float         @default(0)
  week2          Float         @default(0)
  week3          Float         @default(0)
  week4          Float         @default(0)
  order          Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  group          TrackingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model MonthlyCondition {
  id        String   @id @default(cuid())
  periodKey String
  type      String
  title     String?
  color     String?
  text      String
  amount    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodKey])
}

model ExtraRule {
  id                  String            @id @default(uuid())
  name                String
  channelType         String
  description         String?
  combinationLabel    String
  requiredGroups      String
  payoutMode          String
  sameClientRequired  Boolean           @default(true)
  sameSellerRequired  Boolean           @default(true)
  minOccurrences      Int               @default(1)
  maxPayoutUnits      Int?
  telecomRewardAmount Float             @default(0)
  sellerRewardAmount  Float             @default(0)
  validFrom           DateTime?
  validTo             DateTime?
  isActive            Boolean           @default(true)
  periodId            String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  assignments         ExtraAssignment[]
  period              WorkPeriod?       @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model ExtraAssignment {
  id                  String     @id @default(uuid())
  ruleId              String?
  periodId            String
  sourceType          String
  seller              String
  sellerId            String?
  customerNif         String?
  customerName        String?
  triggerKey          String     @unique
  triggerSummary      String?
  sourceSaleIds       String?
  telecomRewardAmount Float
  sellerRewardAmount  Float
  status              String     @default("PENDING")
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  period              WorkPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  rule                ExtraRule? @relation(fields: [ruleId], references: [id])

  @@index([periodId, seller])
}

model ManualExtraTemplate {
  id            String   @id @default(uuid())
  name          String
  channelType   String
  defaultAmount Float
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserActivity {
  id           String   @id @default(cuid())
  userId       String?
  username     String?
  role         String?
  path         String
  action       String?  @default("VIEW")
  device       String?  @default("DESKTOP")
  errorDetails String?
  createdAt    DateTime @default(now())

  @@index([username])
  @@index([createdAt])
}

model TopRouteHistory {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  path      String
  views     Int
  createdAt DateTime @default(now())

  @@unique([month, year, path])
}

model TopUserHistory {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  username  String
  sessions  Int
  actions   Int
  createdAt DateTime @default(now())

  @@unique([month, year, username])
}

model VentaLibroMayor {
  id               String            @id @default(cuid())
  fechaVenta       DateTime
  origen           String
  nifCliente       String
  producto         String
  comisionEsperada Float
  estadoPago       String            @default("PENDIENTE")
  liquidacionId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  liquidacion      LiquidacionTelef? @relation(fields: [liquidacionId], references: [id])

  @@index([nifCliente])
}

model RemesaTelefonica {
  id             String             @id @default(cuid())
  nombreArchivo  String
  mesLiquidacion String
  concepto       String?
  fechaSubida    DateTime           @default(now())
  totalImporte   Float
  totalLineas    Int
  esTotal        Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  liquidaciones  LiquidacionTelef[]
}

model LiquidacionTelef {
  id                String            @id @default(cuid())
  fechaLiquidacion  DateTime
  nifCliente        String
  productoLiquidado String
  importePagado     Float
  remesaId          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  comercial         String?
  tienda            String?
  concepto          String?
  movimiento        String?
  penalizacion      String?
  resCalidad        String?
  resFormacion      String?
  resImagen         String?
  remesa            RemesaTelefonica? @relation(fields: [remesaId], references: [id], onDelete: Cascade)
  ventasVinculadas  VentaLibroMayor[]

  @@index([nifCliente])
}

model TiendaCommissionRule {
  id                  String   @id @default(uuid())
  periodKey           String
  nombre              String
  productosCuentan    String?
  objPrimerTramo      Float?
  importePrimerTramo  String?
  objSegundoTramo     Float?
  importeSegundoTramo String?
  condicionantes      String?
  totalHoras          Float?
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([periodKey])
}

model TiendaStoreObjective {
  id            String   @id @default(uuid())
  periodKey     String
  storeName     String
  bafConvMS     Float?
  bafNoFusionO2 Float?
  restoBaf      Float?
  tvFutbol      Float?
  alarmas       Float?
  dispSegEuros  Float?
  dispUnidades  Float?
  seguros       Float?
  movil         Float?
  repos         Float?
  fttr          Float?
  bafNoTrasl    Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([periodKey, storeName])
}

model TiendaComercialHour {
  id        String   @id @default(uuid())
  periodKey String
  comercial String
  horario   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodKey])
}

model CajaEntry {
  id                 String   @id @default(uuid())
  tienda             String // 'Auxiliadora', 'Villamayor', 'BÃ©jar', 'Correhuela', 'MovilFree', 'Central'
  fecha              String // Formato YYYY-MM-DD
  concepto           String
  detalle            String
  importe            Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  vendedor           String? // Usuario que lo registrÃ³
  estadoTrazabilidad String? // 'ROJO', 'NARANJA', 'VERDE', null
}

model MovilFreeProduct {
  id        String   @id @default(cuid())
  nombre    String
  categoria String   @default("Varios")
  precio    Float
  coste     Float    @default(0)
  stock     Int      @default(0)
  imei      String? // Opcional, 15 digitos
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovilFreeClient {
  id            String   @id @default(cuid())
  nif           String   @unique
  nombre        String
  direccion     String?
  poblacion     String?
  provincia     String?
  cp            String?
  movil         String?
  fijo          String?
  email         String?
  totalComprado Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MovilFreeSale {
  id               String   @id @default(cuid())
  numeroFactura    Int?     @unique
  vendedor         String?
  nifCliente       String?
  nombreCliente    String?
  listaProductos   String // JSON stringified array of { id, nombre, cantidad, precio, subtotal, cantidadDevuelta }
  importeTotal     Float
  estado           String   @default("COMPLETADA") // "COMPLETADA", "DEVUELTA", "DEVOLUCION_PARCIAL"
  metodoPago       String?  @default("Efectivo") // "Efectivo" o "Tarjeta"
  motivoDevolucion String?
  fechaVenta       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StockItem {
  id             String   @id @default(cuid())
  tabCategory    String // 'Exclusivos', 'Rent', 'Dispositivos OJO', 'Accesorios', 'Demos'
  producto       String
  pvd            Float    @default(0)
  pvp            Float    @default(0)
  udsCorrehuela  Int      @default(0)
  udsAuxiliadora Int      @default(0)
  udsBejar       Int      @default(0)
  udsVillamayor  Int      @default(0)
  udsMovilfree   Int      @default(0)
  observaciones  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tabCategory])
}

model Vencimiento {
  id           String   @id @default(cuid())
  proveedor    String
  fechaFactura String
  albaran      String?
  nFactura     String?
  vencimiento  String
  pagado       Boolean  @default(false)
  recargo      Float    @default(0)
  tarjetas     Float    @default(0)
  accesorios   Float    @default(0)
  moviles      Float    @default(0)
  iva          Float    @default(0)
  totalFactura Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GastoMensual {
  id            String   @id @default(uuid())
  year          Int
  month         Int
  grupo         String
  concepto      String
  importe_c     Float    @default(0)
  importe_r     Float    @default(0)
  importe_dif   Float    @default(0)
  importe_total Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([year, month, grupo, concepto])
}

model MovilFreeReparacion {
  id              String   @id @default(cuid())
  numero          Int
  nombreApellidos String
  direccion       String?
  dniNif          String?
  telefono        String?
  marca           String?
  modelo          String?
  imei            String?
  fechaRecepcion  String?
  observaciones   String?
  motivo          String?
  fechaEntrega    String?
  garantia        String?
  informe         String?
  repara          String?
  costePvd        Float?
  pvp             Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MacroFinanceRecord {
  id    String @id @default(cuid())
  year  Int
  month Int

  // Totales Generales
  totalCobradoIva    Float @default(0)
  totalCobradoSinIva Float @default(0)

  // Tiendas
  cajaTiendas              Float @default(0)
  comisionesTiendasLocales Float @default(0)
  prvTiendas               Float @default(0)
  gastosTiendas            Float @default(0)
  comisionesTiendas        Float @default(0)

  // FFVV
  cajaFfvv         Float @default(0)
  produccionPlus   Float @default(0)
  produccionBasico Float @default(0)
  prvFfvv          Float @default(0)
  gastosFfvv       Float @default(0)

  // Comerciales para calcular la media
  numComercialesFfvv Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model PatrimonioRecord {
  id   String @id @default(cuid())
  year Int    @unique

  // Pasivos
  lineaCredito         Float @default(0)
  cuentaCorriente      Float @default(0)
  icoUnicaja1          Float @default(0)
  depositoIberabal     Float @default(0)
  icoUnicaja2          Float @default(0)
  impuestosHacienda    Float @default(0)
  aplazamientoHacienda Float @default(0)
  prestamoPadres       Float @default(0)
  pagoMultaHacienda    Float @default(0)
  despidos             Float @default(0)
  inversionOficinas    Float @default(0)
  creditoTitoVergara   Float @default(0)
  creditoMicroInfor    Float @default(0)
  creditoEmpresaPiso   Float @default(0)

  // Deudas adicionales
  deudaZeleris  Float @default(0)
  deudaMovistar Float @default(0)

  // Activos / Patrimonio
  stockMovistar              Float @default(0)
  stockMovilfree             Float @default(0)
  valorEmpresa               Float @default(0)
  planPensiones              Float @default(0)
  cuentasYCaja               Float @default(0)
  prestamosEmpresa           Float @default(0)
  prestamosHipotecaCampoamor Float @default(0)
  pisosCampoamorRecreo       Float @default(0)
  pisosPrincipeVergara       Float @default(0)
  valorCoche                 Float @default(0)

  // Liquidez �ngel Luis (Fase 2)
  liqSantander                Float @default(0) // Banco Santander Cuenta Personal
  liqUnicaja                  Float @default(0) // Unicaja Cuenta Personal
  liqCajaMetalico             Float @default(0) // Caja Met�lico
  liqRentaCampoamor           Float @default(0) // Renta Piso Avenida de Campoamor
  liqRentaRecreo              Float @default(0) // Renta Piso Calle Recreo
  liqRentaVillaviciosa        Float @default(0) // Renta Piso Calle Villaviciosa
  // planPensiones is shared with Retrospectiva
  liqPrestamoEmpresaPiso      Float @default(0) // Prestamo mio a la Empresa del Piso
  liqPrestamoEmpresa          Float @default(0) // Prestamo mio a la Empresa
  liqPrestamoEmpresaImpuestos Float @default(0) // Prestamo mio a la Empresa Impuestos
  liqPrestamoEmpresaFinMes    Float @default(0) // Prestamo mio a la Empresa Fin de Mes
  liqInteresesPrestamo        Float @default(0) // Intereses Prestamo a la Empresa
  liqSueldos                  Float @default(0) // Sueldos
  liqPisoCampoamor            Float @default(0) // Piso Avenida de Campoamor N�30, 4�C
  liqPisoRecreo               Float @default(0) // Piso Calle Recreo N�13, 2�
  liqPisoVillaviciosa         Float @default(0) // Piso Calle Villaviciosa N�28-32, 2A
  liqHipotecaCampoamor1       Float @default(0) // Unicaja Hipoteca Campoamor (1)
  liqHipotecaCampoamor2       Float @default(0) // Unicaja Hipoteca Campoamor (2)
  liqHacienda                 Float @default(0) // Hacienda

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComisionFFVVTienda {
  id           String @id @default(uuid())
  periodKey    String
  tipo         String // "FFVV" o "TIENDA"
  nombre       String
  importe      Float? @default(0)
  aceleradores Float? @default(0)
  descuentos   Float? @default(0)
  dietas       Float? @default(0)
  km           Float? @default(0)
  gasolina     Float? @default(0)
  incentivos   Float? @default(0)
  o2Varios     Float? @default(0)
  total        Float? @default(0)

  notasVarios  String?
  notasDietas  String?
  notasKm      String?
  notasDescuentos String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ComisionMetadata {
  periodKey String  @id
  titulo    String?
}
